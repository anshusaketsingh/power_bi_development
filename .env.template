# Power BI Builder Agent Configuration
# Copy to `.env` and adjust:  cp .env.template .env

# Path to the target Power BI Project (.pbip) file
POWERBI_PROJECT_PATH="development/<your_project>/<folder>/<name>.pbip"

# Path to the report theme template project
THEME_TEMPLATE_PATH="development/pbi_report_theme_template/JH Theme.pbip"

# Path to the standard page background
BACKGROUND_IMAGE_PATH="assets/background.png"

# Path to the company logo
LOGO_IMAGE_PATH="assets/logo.png"

# Microsoft Skills for Fabric (cloned locally by python_scripts/setup_skills.py)
SKILLS_REPO_URL="https://github.com/microsoft/skills-for-fabric.git"
SKILLS_PATH="skills-for-fabric"
